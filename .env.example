# Copy to .env for local development. Never commit real secrets.
COMPBACK_ENV=dev
COMPBACK_LOG_JSON=false
COMPBACK_COOKIE_SECURE=false
COMPBACK_DATABASE_URL=postgresql+psycopg://compback_app:compback_app@localhost:5432/compback
COMPBACK_DATABASE_OWNER_URL=postgresql+psycopg://compback_owner:compback_owner@localhost:5432/compback
COMPBACK_STORAGE_BACKEND=local
COMPBACK_STORAGE_LOCAL_ROOT=./.data/objects
COMPBACK_KMS_BACKEND=local
# 32 random bytes, base64. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
COMPBACK_LOCAL_MASTER_KEY_B64=
COMPBACK_LLM_PROVIDER=fake
# COMPBACK_ANTHROPIC_API_KEY=   # only when COMPBACK_LLM_PROVIDER=anthropic
COMPBACK_CLAMAV_HOST=localhost
